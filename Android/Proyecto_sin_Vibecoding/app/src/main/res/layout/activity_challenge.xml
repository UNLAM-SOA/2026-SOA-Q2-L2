<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="@string/back"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <!-- Vidas restantes (soa/escape/vidas) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/challengeHeart1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_heart_full" />

            <ImageView
                android:id="@+id/challengeHeart2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_heart_full" />

            <ImageView
                android:id="@+id/challengeHeart3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_heart_full" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/challengeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_primary"
        android:textSize="32sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <!-- 1. Explicacion + Comenzar -->
        <LinearLayout
            android:id="@+id/panelIntro"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/introText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel"
                android:lineSpacingMultiplier="1.15"
                android:padding="24dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/start"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- 2. Esperando al ESP32 (desafios 1 y 2) -->
        <LinearLayout
            android:id="@+id/panelWaiting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <!-- Subpanel D1: Esperando aplausos -->
            <LinearLayout
                android:id="@+id/containerD1Waiting"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/piece_amber" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/waiting_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/waiting_hint"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Subpanel D2: Gauge / Grafico de Potenciometro en tiempo real -->
            <LinearLayout
                android:id="@+id/containerD2Gauge"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Calibración analógica"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <com.example.escaperoom.PotentiometerGaugeView
                    android:id="@+id/potGaugeView"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:text="Mové el potenciómetro para resolver la consigna del display y dejalo quieto 3 segundos para confirmar."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_outline"
                android:paddingHorizontal="32dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 3. Minijuego de memoria (desafio 3) -->
        <ScrollView
            android:id="@+id/panelGame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/gameHits"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/gameTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/piece_amber"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/heapCapacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/heapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="horizontal"
                    android:padding="12dp" />

                <TextView
                    android:id="@+id/requestLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnProduce"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/btn_produce"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/btnConsume"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/btn_consume"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Caja del codigo secreto -->
                <TextView
                    android:id="@+id/codeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/code_title"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/codeReveal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_panel"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.4"
                    android:paddingVertical="20dp"
                    android:text="@string/code_locked"
                    android:textColor="@color/piece_amber"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/codeEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/codeInput"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_tile_idle"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:hint="@string/code_hint"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:letterSpacing="0.3"
                        android:maxLength="4"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/codeError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/code_wrong"
                        android:textColor="@color/result_lose"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 4. Resultado -->
        <LinearLayout
            android:id="@+id/panelResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/resultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="40dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:text="@string/back_to_menu"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>